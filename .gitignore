# 観測データは巨大なのでリポジトリには入れない（scripts/fetch_data.py で再取得）
data/

# スクリプトが書き出す図。ただし figures/reference/ は
# 「正しく動いたときの見本」としてリポジトリに入れる
figures/*
!figures/reference/
# 講習会の教材として使う図は、生成スクリプトとセットで入れる
!figures/ioneq_ladder.png
!figures/emloci_region7.png
!figures/alpha_meaning.png
!figures/dem_compare.png

*.pyc
__pycache__/
.ipynb_checkpoints/
.claude/settings.local.json

# 実行ログ（再生成できる。SSW の起動チャターで巨大になる）
logs/

# 中間ファイル。小さいテキストだけ選んで入れる（下の ! を参照）
work/*
!work/gofnt_chianti901.txt
!work/aia94_fe18_response.txt
!work/eis_calcurve_20110702.txt
!work/eispac_templates.csv
!work/idl_intensities_tied.csv
!work/idl_intensities_box246.csv
!work/idl_ca_intensities.csv
!work/mcmc_dem_result.txt
!work/box_scan.csv
!work/perline_scan.csv

# pdftotext の出力（PDF から再生成できる）
papers/refs/*.txt
